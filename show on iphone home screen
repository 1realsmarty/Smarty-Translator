<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="manifest" href="/manifest.json">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Tikitaka">
<meta name="theme-color" content="#ffffff">
<title>Tikitaka – Accurate translator</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
--bg:#fff;--card:#d9e6f7;--blue:#418de0;--text:#111;--muted:#777;--del:#d32f2f;--ins:#1faa3a;--ghost:#1a3f7a}
html,body{margin:0}
body{background:var(--bg);color:var(--text);font:16px/1.4 Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:520px;margin:0 auto;padding:28px 20px 48px}
header{display:flex;align-items:center;gap:10px}
header img{height:40px}
h1{font-size:34px;margin:0;font-weight:700}
.sub{margin:6px 0 16px;font-size:17px}
.card{background:var(--card);border-radius:12px;padding:18px 24px;margin-bottom:8px}
.row{display:flex;gap:14px}
.grow{flex:1;min-width:0}
label{display:block;font-size:14px;margin:0 0 8px}
select{width:100%;height:36px;border:0;border-radius:10px;background:var(--blue);color:#fff;font:inherit;font-size:16px;padding:0 14px;appearance:none;-webkit-appearance:none}
textarea{width:100%;box-sizing:border-box;height:132px;border:0;border-radius:10px;background:var(--blue);color:#fff;font:inherit;font-size:17px;padding:12px;box-shadow:0 2px 6px rgba(0,0,0,.2);resize:none}
textarea::placeholder{color:rgba(255,255,255,.7)}
textarea:focus{outline:2px solid #fff}
button{background:var(--blue);color:#fff;border:0;border-radius:14px;height:48px;min-width:116px;padding:0 20px;font:inherit;font-size:17px;cursor:pointer}
button.ghost{background:transparent;color:var(--ghost);border:1px solid var(--blue);border-radius:8px;height:28px;min-width:0;padding:0 14px;font-size:14px}
button.rec{background:var(--del);color:#fff;border-color:transparent}
button:disabled{opacity:.5;cursor:default}
.actions{display:flex;justify-content:space-between;align-items:flex-end;margin-top:16px}
h2{font-size:17px;margin:0 0 12px;font-weight:700}
.hd{display:flex;justify-content:space-between;align-items:flex-start}
.hd span{display:flex;gap:8px}
.out{font-size:17px;white-space:pre-wrap;word-break:break-word;margin:0 0 14px}
.det{color:var(--muted);font-size:13px;margin:-8px 0 8px}
ul{margin:0;padding-left:20px}
li{margin-bottom:8px;font-size:14px}
.old,.new{font-size:17px}
.old{color:var(--del);text-decoration:line-through}
.new{color:var(--ins)}
.why{font-size:14px}
#status{margin-top:10px;font-size:14px}
.err{color:var(--del)}
.hidden{display:none}
</style>
</head>
<body>
<main>
  <header><img alt="" src="data:image/png;base64,"><h1>Tikitaka</h1></header>
  <p class="sub">Accurate translator</p>

  <div class="card">
    <div class="row">
      <div class="grow"><label for="src">From</label>
        <select id="src"><option>Auto-detect</option></select></div>
      <div class="grow"><label for="tgt">To</label>
        <select id="tgt"></select></div>
    </div>
    <label for="inp" style="margin-top:16px">Your text</label>
    <textarea id="inp" maxlength="2000"></textarea>
    <div class="actions">
      <button id="go">Translate</button>
      <button type="button" id="mic" class="ghost">Speak</button>
    </div>
    <div id="status" class="why"></div>
  </div>

  <div id="res" class="hidden">
    <div class="card"><h2>Translation</h2>
      <div class="out" id="trn"></div>
      <button data-copy="trn">Copy</button></div>
    <div class="card"><div class="hd"><h2>Correction</h2><span><button class="ghost" data-say="cor">Listen</button><button class="ghost" data-copy="cor">Copy</button></span></div>
      <div class="det" id="detected"></div><div class="out" id="cor" style="margin:0"></div></div>
    <div class="card" id="chg"><h2>What I fixed</h2><ul id="list"></ul></div>
  </div>
</main>

<script>
var LANGS=["English","Spanish","French","German","Italian","Portuguese","Dutch","Papiamento","Russian","Arabic","Hindi","Bengali","Chinese (Simplified)","Chinese (Traditional)","Japanese","Korean","Turkish","Polish","Swahili","Yoruba","Igbo","Hausa","Nigerian Pidgin","Indonesian","Vietnamese","Thai","Greek","Hebrew","Ukrainian","Swedish"];
var src=document.getElementById("src"),tgt=document.getElementById("tgt"),
inp=document.getElementById("inp"),go=document.getElementById("go"),
st=document.getElementById("status"),res=document.getElementById("res");
LANGS.forEach(function(l){src.add(new Option(l));var o=new Option(l);tgt.add(o);if(l==="English")o.selected=true});

function setText(id,t){document.getElementById(id).textContent=t==null?"":String(t)}

async function translate(text,from,to){
  var r=await fetch("/api/translate",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({text:text,from:from,to:to})});
  var d=await r.json().catch(function(){return {}});
  if(!r.ok)throw new Error(d.error||"Something went wrong. Please try again.");
  return d;
}

go.onclick=async function(){
  var text=inp.value.trim();
  if(!text){st.className="why";st.textContent="Enter some text first.";return}
  go.disabled=true;st.className="why";st.textContent="Working…";
  try{
    var r=await translate(text,src.value,tgt.value);
    setText("detected","Detected: "+(r.detected||"unknown"));
    setText("cor",r.corrected);setText("trn",r.translation);
    var ul=document.getElementById("list");ul.textContent="";
    var ch=Array.isArray(r.changes)?r.changes:[];
    ch.forEach(function(c){
      var li=document.createElement("li");
      var a=document.createElement("span");a.className="old";a.textContent=c.from==null?"":String(c.from);
      var b=document.createElement("span");b.className="new";b.textContent=c.to==null?"":String(c.to);
      var w=document.createElement("div");w.className="why";w.textContent=c.reason==null?"":String(c.reason);
      li.append(a," → ",b,w);ul.append(li);
    });
    if(!ch.length){var li=document.createElement("li");li.className="why";li.textContent="No mistakes found.";ul.append(li)}
    res.classList.remove("hidden");st.textContent="";
  }catch(e){
    st.className="why err";st.textContent=e.message||"Something went wrong. Please try again.";
  }
  go.disabled=false;
};

document.addEventListener("click",function(e){
  var id=e.target.getAttribute&&e.target.getAttribute("data-copy");
  if(!id)return;
  var t=document.getElementById(id).textContent;
  try{navigator.clipboard.writeText(t);e.target.textContent="Copied"}catch(x){e.target.textContent="Select to copy"}
  setTimeout(function(){e.target.textContent="Copy"},1500);
});

(function(){
var CODES={"English":"en-US","Spanish":"es-ES","French":"fr-FR","German":"de-DE","Italian":"it-IT","Portuguese":"pt-PT","Dutch":"nl-NL","Papiamento":"nl-NL","Russian":"ru-RU","Arabic":"ar-SA","Hindi":"hi-IN","Bengali":"bn-BD","Chinese (Simplified)":"zh-CN","Chinese (Traditional)":"zh-TW","Japanese":"ja-JP","Korean":"ko-KR","Turkish":"tr-TR","Polish":"pl-PL","Swahili":"sw-KE","Yoruba":"yo-NG","Igbo":"ig-NG","Hausa":"ha-NG","Nigerian Pidgin":"en-NG","Indonesian":"id-ID","Vietnamese":"vi-VN","Thai":"th-TH","Greek":"el-GR","Hebrew":"he-IL","Ukrainian":"uk-UA","Swedish":"sv-SE"};
function say(id){
  if(!("speechSynthesis" in window)){st.className="why err";st.textContent="Read-aloud isn’t supported in this browser.";return}
  var text=document.getElementById(id).textContent;if(!text)return;
  var name=id==="trn"?tgt.value:(src.value==="Auto-detect"?document.getElementById("detected").textContent.replace("Detected: ",""):src.value);
  var lang=CODES[name]||"";
  speechSynthesis.cancel();
  var u=new SpeechSynthesisUtterance(text);
  if(lang){
    u.lang=lang;
    var vs=speechSynthesis.getVoices(),pre=lang.slice(0,2);
    var ok=vs.length===0||vs.some(function(v){return v.lang.toLowerCase().indexOf(pre)===0});
    if(!ok){st.className="why err";st.textContent="This device has no "+name+" voice installed.";return}
  }
  st.className="why";
  st.textContent=name==="Papiamento"?"Using a Dutch voice for Papiamento, so the pronunciation may sound off.":"";
  speechSynthesis.speak(u);
}
var SR=window.SpeechRecognition||window.webkitSpeechRecognition,mic=document.getElementById("mic"),rec=null,on=false;
if(!SR)mic.classList.add("hidden");
mic.onclick=function(){
  if(on){if(rec)rec.stop();return}
  var name=src.value,lang=name==="Auto-detect"?(navigator.language||"en-US"):(CODES[name]||"en-US");
  rec=new SR();rec.lang=lang;rec.interimResults=true;rec.continuous=true;
  var base=inp.value?inp.value.replace(/\s*$/," "):"";
  rec.onresult=function(e){var t="";for(var i=0;i<e.results.length;i++)t+=e.results[i][0].transcript;inp.value=base+t};
  rec.onerror=function(e){st.className="why err";st.textContent=(e.error==="not-allowed"||e.error==="service-not-allowed")?"Microphone access is blocked. You can still type your text.":"Voice input stopped ("+e.error+")."};
  rec.onend=function(){on=false;mic.textContent="Speak";mic.classList.remove("rec")};
  try{
    rec.start();on=true;mic.textContent="Stop";mic.classList.add("rec");st.className="why";
    st.textContent=name==="Auto-detect"?"Listening in "+lang+". Pick a source language to dictate in another one.":name==="Papiamento"?"Listening with a Dutch model. Browsers don’t support Papiamento dictation, so expect errors.":"Listening…";
  }catch(x){}
};
document.addEventListener("click",function(e){var id=e.target.getAttribute&&e.target.getAttribute("data-say");if(id)say(id)});
})();
</script>
</body>
</html>

{
  "name": "Tikitaka",
  "short_name": "Tikitaka",
  "description": "Accurate translator",
  "start_url": "/",
  "display": "standalone",
